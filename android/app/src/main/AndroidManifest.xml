<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Modo MCP through the relay, only when the user turns it on (off by default). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- «Desinstalar» in an app's menu opens the phone's own uninstall question. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- «Redireccionar a Hub»: only apps signed with the same key (Gateway Hub) get this permission. -->
    <permission android:name="com.zirakusa.gatewayhub.permission.LINK" android:protectionLevel="signature"
        android:label="@string/hub_link_permission" />
    <!-- «Hoy»: the family apps' summaries (Reloj, Calendario…); only apps signed with the same key hold this permission. -->
    <permission android:name="com.zirakusa.family.permission.SUMMARY" android:protectionLevel="signature"
        android:label="@string/summary_permission" />
    <uses-permission android:name="com.zirakusa.family.permission.SUMMARY" />
    <!-- Which apps there are: the ones with a launcher entry (no QUERY_ALL_PACKAGES), the family apps and the dock's first guesses. -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="com.zirakusa.gatewayhub.action.APP" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <package android:name="com.zirakusa.gatewayhub" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Wallpaper.NoTitleBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:clearTaskOnLaunch="true" android:stateNotNeeded="true" android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" android:resumeWhilePausing="true" android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gateway Hub's scanner finds the launcher (module launcher_) and its link channel. Being found turns nothing on. -->
            <intent-filter>
                <action android:name="com.zirakusa.gatewayhub.action.APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.zirakusa.gatewayhub.module" android:value="launcher_" />
            <meta-data android:name="com.zirakusa.gatewayhub.link" android:value="${applicationId}.hublink" />
        </activity>
        <provider android:name=".mcp.HubLinkProvider" android:authorities="${applicationId}.hublink"
            android:exported="true" android:permission="com.zirakusa.gatewayhub.permission.LINK" />
    </application>
</manifest>
